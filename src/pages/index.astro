---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.tsx';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const latestArticle = articles.sort((a, b) => 
  new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
)[0];
const { Content } = await latestArticle.render();
---

<Layout title="Mind Matters - Psychology Blog">
  <Header />
  <main class="container" style="padding: 4rem 2rem;">
    <div class="card">
      <article class="article-content">
        <div class="article-meta">
          Published on {latestArticle.data.publishedAt.toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
          })} • {latestArticle.data.readingTime}
        </div>
        
        <h2>{latestArticle.data.title}</h2>
        <p style="color: var(--text-light); font-size: 1.1rem; margin-bottom: 2rem;">
          {latestArticle.data.description}
        </p>
        
        <div class="markdown-content">
          <Content />
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Layout>
