---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.tsx';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import articleHero from '../assets/article-hero.jpg';

const articles = await getCollection('articles');
const latestArticle = articles.sort((a, b) => 
  new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
)[0];
const { Content } = await latestArticle.render();
---

<Layout title="Marta Gil - Blog de Psicología">
  <Header />
  
  <!-- Section 1: Dark Header with Title and Image -->
  <section class="article-hero">
    <div class="container">
      <div class="article-hero-content">
        <div class="article-meta-section">
          <h1 class="article-title">{latestArticle.data.title}</h1>
          <div class="article-meta">
            <span class="publish-date">
              {latestArticle.data.publishedAt.toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              })}
            </span>
            <span class="read-time">{latestArticle.data.readingTime}</span>
          </div>
        </div>
        <div class="article-image">
          <Image 
            src={articleHero} 
            alt={latestArticle.data.title}
            width={400}
            height={300}
            class="hero-image"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Light Article Content -->
  <section class="article-body">
    <div class="container">
      <div class="content-wrapper">
        <Content />
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>
